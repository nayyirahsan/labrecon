{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(npx vercel *)",
      "Bash(xargs cat)",
      "Bash(grep -v \"^$\")",
      "Bash(timeout 10 node -e ' *)",
      "Bash(node -e ' *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000)",
      "Bash(curl -s -o /dev/null -w \"first: %{time_total}s\\\\n\" http://localhost:3000)",
      "Bash(curl -s -o /dev/null -w \"second: %{time_total}s\\\\n\" http://localhost:3000)",
      "Bash(curl -v --max-time 20 http://localhost:3000)",
      "Bash(node *)",
      "Bash(curl *)"
    ]
  }
}
